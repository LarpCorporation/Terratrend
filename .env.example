# TerraTrend Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Server Network Configuration
HOST=0.0.0.0
PORT=8517

# NASA Earthdata Authentication (Optional, can also be connected via the web UI)
# Generate your token at: https://urs.earthdata.nasa.gov/
EARTHDATA_TOKEN=

# NASA AppEEARS Authentication (Optional, for vegetation datasets)
# Generate via: https://appeears.earthdatacloud.nasa.gov/
APPEEARS_TOKEN=

# AI Assistant & Plain-Language Explanation (Optional)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=
TERRATREND_GROQ_MODEL=llama-3.3-70b-versatile
