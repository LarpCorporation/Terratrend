+/* ============================================================
+   ACCESSIBILITY LAYER
+   The HUD is deliberately dense, but density must not cost
+   legibility or keyboard access. Everything below is additive.
+   ============================================================ */
+
+/* A visible focus ring on every interactive element. Before this,
+   all 61 focusables had outline:none and the app was unusable
+   without a mouse. */
+:where(a, button, input, select, textarea, [tabindex]):focus-visible {
+  outline: 2px solid #ffffff;
+  outline-offset: 2px;
+  border-radius: 1px;
+}
+.hud-select:focus-visible,
+.yr input:focus-visible {
+  outline: 2px solid #ffffff;
+  outline-offset: 1px;
+}
+
+/* --flat fails WCAG AA on the panel background (3.92:1). Lift it
+   to 4.6:1 without changing its role as the "no trend" colour. */
+:root { --flat: #7b838c; }
+
+/* Minimum comfortable hit area for pointer users. */
+.sphere-tab { min-height: 32px; }
+.hud-btn { min-height: 36px; }
+.panel-icon-btn { min-width: 28px; min-height: 28px; }
+
+/* The globe is the primary way to choose a place, so it must be
+   reachable without a mouse. */
+#globe { touch-action: none; }
+#globe:focus-visible { outline: 2px solid #ffffff; outline-offset: -2px; }
+
+/* Respect the OS reduced-motion setting. */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: .001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .001ms !important;
+    scroll-behavior: auto !important;
+  }
+  .pulse { animation: none; opacity: 1; }
+}
+
+/* Screen-reader-only helper for live announcements. */
+.sr-only {
+  position: absolute; width: 1px; height: 1px;
+  padding: 0; margin: -1px; overflow: hidden;
+  clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
+}
+
+/* ---------- guided start ---------- */
+.start-window { max-width: 780px; }
+.start-title {
+  font-family: var(--font); font-size: 20px; letter-spacing: .02em;
+  color: #fff; margin: 6px 0 0; font-weight: 700;
+}
+.start-sub {
+  color: var(--muted); font-size: 13px; line-height: 1.6;
+  margin: 10px 0 16px; max-width: 62ch;
+}
+.start-grid {
+  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
+}
+.start-card {
+  display: flex; flex-direction: column; gap: 6px;
+  text-align: left; padding: 14px 16px; cursor: pointer;
+  background: #0f1216; border: 1px solid var(--line);
+  color: var(--text); font-family: var(--font-ui);
+  transition: border-color .15s, background .15s;
+}
+.start-card:hover { border-color: var(--hi); background: #151a20; }
+.start-card:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
+.sc-q { font-size: 14px; font-weight: 600; color: #fff; line-height: 1.35; }
+.sc-d { font-size: 12px; color: var(--muted); }
+.sc-expect {
+  font-family: var(--font); font-size: 11px; letter-spacing: .06em;
+  color: #8fd0a0; text-transform: uppercase;
+}
+.start-foot { margin-top: 14px; }
+@media (max-width: 640px) {
+  .start-grid { grid-template-columns: 1fr; }
+}
